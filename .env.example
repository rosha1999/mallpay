# Local PostgreSQL. For hosted databases, set the runtime URL and a direct migration URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mallpay?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mallpay?schema=public"
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Set to x-real-ip only when a trusted ingress overwrites that header.
RATE_LIMIT_TRUSTED_IP_HEADER=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="ar_IQ"
EMAIL_API_KEY=""
EMAIL_FROM="MallPay <notifications@example.com>"

# Protect the notification worker endpoint; use a long random value
NOTIFICATION_CRON_SECRET=""

# OpenWA self-hosted WhatsApp gateway (alternative to the Meta Cloud API).
# When OPENWA_BASE_URL and OPENWA_API_KEY are set, WhatsApp notifications are
# sent through this gateway instead of Meta. The key must be scoped to the
# named session only and must not be IP-allowlisted.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_NAME=mallpay
